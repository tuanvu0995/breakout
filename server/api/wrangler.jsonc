{
  "name": "bs-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "bs-api.pixalab.co", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "bs-db", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "STORE", "bucket_name": "bs-store" }],
  "vars": {
    "ALLOWED_BUILD_MIN": "0.0.0",
    "SESSION_TTL_DAYS": "365",
    "RUNS_PER_HOUR": "120",
    "STORE_PUBLIC_URL": ""
  }
  // secret: ADMIN_TOKEN  (npx wrangler secret put ADMIN_TOKEN; .dev.vars for local)
}
